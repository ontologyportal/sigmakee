<project xmlns:ivy="antlib:org.apache.ivy.ant" name="SigmaKEE" default="all" basedir=".">
    <description>
        This build file builds, tests, packages, and deploys SigmaKEE from the
        command line and in CI/CD environments.
    </description>
    <property environment="env"/>

    <!--
    ==========================================================================
    PROJECT METADATA
    ==========================================================================
    -->
    <property name="impl.title" value="${ant.project.name}"/>
    <property name="product.Name" value="Sigma Knowledge Engineering Environment (${impl.title})"/>
    <property name="product.version.major" value="3"/>
    <property name="product.version.minor" value="0"/>
    <property name="product.version.patch" value="0"/>
    <property name="product.Version" value="${product.version.major}.${product.version.minor}.${product.version.patch}"/>
    <property name="spec.vendor" value="Adam Pease"/>
    <property name="nps" value="Naval Postgraduate School (NPS), Monterey, CA"/>
    <property name="cs.dept" value="Computer Science (CS) DEPT"/>
    <property name="sumo.url" value="http://www.ontologyportal.org"/>
    <property name="impl.vendor.id" value="edu.nps.cs"/>
    <property name="main.class" value="com.articulate.sigma.KB"/>

    <!--
    ==========================================================================
    DIRECTORIES AND FILES
    ==========================================================================
    -->
    <property name="app.name" value="sigma"/>
    <property name="web.app.name" value="${app.name}kee"/>
    <property name="src.dir" value="src/java"/>
    <property name="test.corpus.dir" value="test/corpus/java"/>
    <property name="test.unit.dir" value="test/unit/java"/>
    <property name="test.integration.dir" value="test/integration/java"/>
    <property name="build.home" value="build"/>
    <property name="build.classes" value="${build.home}/classes"/>
    <property name="build.test.classes" value="${build.home}/test/classes"/>
    <property name="reports.dir" value="${build.home}/test/results"/>
    <property name="web.dir" value="web"/>
    <property name="dist.javadoc.dir" value="doc/javadoc"/>
    <property name="manifest.mf" value="MANIFEST.MF"/>
    <property name="tomcat.home" value="${env.CATALINA_HOME}"/>
    <property name="dist.home" value="${tomcat.home}/webapps"/>
    <property name="dist.war" value="${dist.home}/${app.name}.war"/>
    <property name="deploy.home" value="${dist.home}/${app.name}"/>
    <property name="sigma.home" value="${env.SIGMA_HOME}"/>


    <!--
    ==========================================================================
    EXTERNAL DEPENDENCIES
    ==========================================================================
    -->
    <property name="tptp.home" value="../TPTP-ANTLR"/>
    <property name="sigma.utils.home" value="../SigmaUtils"/>
    <property name="sigma.antlr.home" value="../sigmaAntlr"/>
    <property name="ivy.install.version" value="2.5.1"/>
    <property name="ivy.home" value="${basedir}/.ivy"/>
    <property name="ivy.jar.dir" value="${ivy.home}/lib"/>
    <property name="ivy.jar.file" value="${ivy.jar.dir}/ivy.jar"/>


    <!--
    ==========================================================================
    COMPILATION AND TEST SETTINGS
    ==========================================================================
    -->
    <property name="javac.release" value="21"/>
    <property name="run.jvmargs" value="-Xmx10g -Xss1m"/>
    <property name="unit.test.suite" value="com.articulate.sigma.UnitTestSuite"/>
    <property name="integration.test.suite" value="com.articulate.sigma.IntegrationTestSuite"/>
    <property name="report.html" value="file:${basedir}/${reports.dir}/html/index.html"/>


    <!--
    ==========================================================================
    CONDITIONS
    ==========================================================================
    -->
    <condition property="external.atp.tests.enabled"
               value="${env.RUN_EXTERNAL_ATP_TESTS}">
        <isset property="env.RUN_EXTERNAL_ATP_TESTS"/>
    </condition>

    <condition property="external.atp.tests.enabled" value="true" else="false">
        <not>
            <isset property="env.GITHUB_ACTIONS"/>
        </not>
    </condition>

    <condition property="isUnixNotMac">
        <and>
            <os family="unix"/>
            <not>
                <os family="mac"/>
            </not>
        </and>
    </condition>

    <condition property="isMac">
        <os family="mac"/>
    </condition>

    <!--
    ==========================================================================
    SOURCE PATHS
    ==========================================================================
    -->
    <path id="core.sourcepath">
        <pathelement path="${src.dir}/com/articulate/sigma"/>
        <pathelement path="${src.dir}/com/articulate/delphi"/>
    </path>

    <path id="test.sourcepath">
        <pathelement path="${test.corpus.dir}/com/articulate/sigma"/>
        <pathelement path="${test.unit.dir}/com/articulate/sigma"/>
        <pathelement path="${test.integration.dir}/com/articulate/sigma"/>
    </path>


    <!--
    ==========================================================================
    IVY DEPENDENCY RESOLUTION
    ==========================================================================
    -->

    <target name="validate.environment" description="Validate required environment variables.">
        <fail message="CATALINA_HOME is not set.">
            <condition>
                <not>
                    <isset property="env.CATALINA_HOME"/>
                </not>
            </condition>
        </fail>
        <fail message="CATALINA_HOME does not identify an existing directory: ${env.CATALINA_HOME}">
            <condition>
                <and>
                    <isset property="env.CATALINA_HOME"/>
                    <not>
                        <available file="${env.CATALINA_HOME}"
                                type="dir"/>
                    </not>
                </and>
            </condition>
        </fail>
    </target>

    <target name="check.for.ivy.jar">
        <available file="${ivy.jar.file}" property="ivy.present"/>
    </target>
    
    <target name="download-ivy" depends="check.for.ivy.jar" unless="ivy.present">
        <mkdir dir="${ivy.jar.dir}"/>
        <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.install.version}/ivy-${ivy.install.version}.jar" dest="${ivy.jar.file}" usetimestamp="true"/>
    </target>
    
    <target name="init-ivy" depends="download-ivy">
        <path id="ivy.lib.path">
            <fileset dir="${ivy.jar.dir}" includes="*.jar"/>
        </path>
        <taskdef resource="org/apache/ivy/ant/antlib.xml" uri="antlib:org.apache.ivy.ant" classpathref="ivy.lib.path"/>
        <ivy:retrieve/>
        <path id="compile.classpath">
            <fileset dir="${basedir}/lib">
                <include name="*.jar"/>
                <exclude name="junit*"/>
                <exclude name="hamcrest*"/>
            </fileset>
        </path>
        <path id="compile.test.classpath">
            <path refid="compile.classpath"/>
            <pathelement location="${build.classes}"/>
            <pathelement location="${basedir}/lib/hamcrest-core-1.3.jar"/>
            <pathelement location="${basedir}/lib/junit-4.13.2.jar"/>
            <fileset dir="${env.CATALINA_HOME}/lib">
                <include name="*.jar"/>
            </fileset>
            <pathelement location="${env.CATALINA_HOME}/bin/tomcat-juli.jar"/>
            <pathelement location="${ant.home}/lib/ant.jar"/>
        </path>
        <path id="run.test.classpath">
            <path refid="compile.test.classpath"/>
            <pathelement location="${build.test.classes}"/>
        </path>
    </target>


    <!--
    ==========================================================================
    INITIALIZATION
    ==========================================================================
    -->
    <target name="init" depends="validate.environment,init-ivy" description="Initialize and validate the build environment.">
        <condition property="jdk21+">
            <javaversion atleast="21"/>
        </condition>
        <fail message="Unsupported JDK version: ${ant.java.version}. Please use a Java Development Kit (JDK) version 21 or greater." unless="jdk21+">
        </fail>
        <echo message="Welcome to the ${product.Name} v${product.Version}"/>
        <echo message="Specification Vendor:     ${spec.vendor}"/>
        <echo message=""/>
        <echo message="CATALINA_HOME is set to:  ${tomcat.home}"/>
        <echo message="SIGMA_HOME    is set to:  ${sigma.home}"/>
        <echo message="basedir       is set to:  ${basedir}"/>
        <echo message="classpath:                ${env.SIGMA_CP}"/>
        <echo message="Java Version via Ant:     ${ant.java.version}"/>
        <echo message="Java Version System Prop: ${java.version}"/>
        <echo message="JDK HOME:     is set to:  ${java.home}"/>
        <tstamp>
            <format property="TODAY_US" pattern="EEE, d MMM yyyy HHmm Z" locale="en,US"/>
        </tstamp>
    </target>


    <!--
    ==========================================================================
    DEPENDENCY PREPARATION
    ==========================================================================
    -->
    <target name="prepare.dependencies" depends="init">
        <mkdir dir="${basedir}/lib"/>
        <available file="${tptp.home}/tptp.jar" property="tptp.jar.exists"/>
        <fail unless="tptp.jar.exists" message="Missing ${tptp.home}/tptp.jar. Build TPTP-ANTLR first."/>
        <available file="${sigma.utils.home}/sigmaUtils.jar" property="sigma.utils.jar.exists"/>
        <fail unless="sigma.utils.jar.exists" message="Missing ${sigma.utils.home}/sigmaUtils.jar. Build SigmaUtils first."/>
        <available file="${sigma.antlr.home}/sigmaAntlr.jar" property="sigma.antlr.jar.exists"/>
        <fail unless="sigma.antlr.jar.exists" message="Missing ${sigma.antlr.home}/sigmaAntlr.jar. Build sigmaAntlr first."/>
        <copy todir="${basedir}/lib" file="${tptp.home}/tptp.jar" overwrite="true"/>
        <copy todir="${basedir}/lib" file="${sigma.utils.home}/sigmaUtils.jar" overwrite="true"/>
        <copy todir="${basedir}/lib" file="${sigma.antlr.home}/sigmaAntlr.jar" overwrite="true"/>
    </target>


    <!--
    ==========================================================================
    COMPILATION
    ==========================================================================
    -->
    <target name="compile" depends="prepare.dependencies" description="Compile the project and place classes in ${build.classes}.">
        <mkdir dir="${build.classes}"/>
        <javac destdir="${build.classes}" debug="on" optimize="on" deprecation="off" includeantruntime="false" release="${javac.release}">
            <src refid="core.sourcepath"/>
            <classpath>
                <path refid="compile.classpath"/>
                <pathelement location="${tptp.home}/build/classes"/>
                <pathelement location="${tptp.home}/tptp.jar"/>
            </classpath>
        </javac>
    </target>

    <target name="compile.test" depends="compile" description="Compile the project's test classes.">
        <mkdir dir="${build.test.classes}"/>
        <javac destdir="${build.test.classes}" debug="on" optimize="on" deprecation="on" includeantruntime="false" classpathref="compile.test.classpath" release="${javac.release}">
            <src refid="test.sourcepath"/>
        </javac>
        <mkdir dir="${reports.dir}"/>
    </target>


    <!--
    ==========================================================================
    TESTS
    ==========================================================================
    -->
    <target name="test.unit" depends="compile.test">
        <junit printsummary="yes" showoutput="yes" fork="yes">
            <jvmarg line="${run.jvmargs}"/>
            <env key="RUN_EXTERNAL_ATP_TESTS" value="${external.atp.tests.enabled}"/>
            <formatter type="plain" usefile="false"/>
            <classpath>
                <path refid="run.test.classpath"/>
            </classpath>
            <test name="${unit.test.suite}" haltonfailure="no" todir="${reports.dir}">
                <formatter type="xml"/>
            </test>
        </junit>
    </target>
    
    <target name="test.integration" depends="compile.test" description="Run the integration test suite.">
        <junit printsummary="yes" showoutput="yes" fork="yes">
            <jvmarg line="${run.jvmargs}"/>
            <formatter type="plain" usefile="false"/>
            <classpath>
                <path refid="run.test.classpath"/>
            </classpath>
            <test name="${integration.test.suite}" haltonfailure="no" todir="${reports.dir}">
                <formatter type="xml"/>
            </test>
        </junit>
    </target>
    
    <target name="junit.report" description="Generate the HTML JUnit report.">
        <junitreport todir="${reports.dir}">
            <fileset dir="${reports.dir}">
                <include name="TEST-*.xml"/>
            </fileset>
            <report format="frames" todir="${reports.dir}/html"/>
        </junitreport>
    </target>

    <target name="test" depends="test.unit,test.integration,junit.report" description="Run all tests and generate the JUnit report."/>
    

    <!--
    ==========================================================================
    REPORT VIEWING
    ==========================================================================
    -->
    <target name="report.mac" if="isMac">
        <exec executable="sh" osfamily="mac">
            <arg value="-c"/>
            <arg value="open -u ${report.html}"/>
        </exec>
    </target>

    <target name="report.unix" if="isUnixNotMac">
        <exec executable="sh" osfamily="unix">
            <arg value="-c"/>
            <arg value="xdg-open ${report.html}"/>
        </exec>
    </target>

    <target name="open.junit.report" depends="report.mac,report.unix" description="Open the generated JUnit report."/>


    <!--
    ==========================================================================
    VERSION METADATA
    ==========================================================================
    -->
    <target name="generate-version" depends="init" description="Write version.properties to build/classes.">
        <mkdir dir="${build.classes}"/>
        <exec executable="git" outputproperty="git.commit.sha" failifexecutionfails="false" failonerror="false">
            <arg value="rev-parse"/>
            <arg value="--short"/>
            <arg value="HEAD"/>
        </exec>
        <condition property="build.commit" value="${git.commit.sha}">
            <and>
                <isset property="git.commit.sha"/>
                <not><equals arg1="${git.commit.sha}" arg2=""/></not>
            </and>
        </condition>
        <property name="build.commit" value="dev"/>
        <exec executable="git" outputproperty="git.commit.date" failifexecutionfails="false" failonerror="false">
            <arg value="log"/>
            <arg value="-1"/>
            <arg value="--format=%cs"/>
        </exec>
        <property name="git.commit.date" value=""/>
        <echo file="${build.classes}/version.properties" append="false">build.version=${product.Version}-${build.commit}
build.commit=${build.commit}
build.date=${git.commit.date}
        </echo>
    </target>

    <!--
    ==========================================================================
    DOCUMENTATION
    ==========================================================================
    -->
    <target name="api_doc" depends="compile" description="Build the JavaDocs and place in ${dist.javadoc.dir}.">
        <delete dir="${dist.javadoc.dir}" failonerror="false"/>
        <mkdir dir="${dist.javadoc.dir}"/>
        <javadoc sourcepath="${src.dir}" destdir="${dist.javadoc.dir}" author="true" version="true" use="true" private="true" splitindex="true" windowtitle="SigmaKEE API Documentation" packagenames="com.articulate.*" encoding="UTF-8" charset="UTF-8" docencoding="UTF-8">
            <classpath>
                <path refid="compile.classpath"/>
                <pathelement location="${build.classes}"/>
                <pathelement location="${tptp.home}/build/classes"/>
                <pathelement location="${tptp.home}/tptp.jar"/>
            </classpath>
            <doctitle>SigmaKEE API Documentation</doctitle>
            <header><![CDATA[<b>SigmaKEE API Documentation</b>]]></header>
            <group title="Sigma" packages="com.articulate.sigma.*"/>
            <group title="Delphi" packages="com.articulate.delphi.*"/>
            <arg value="-Xdoclint:none"/>
        </javadoc>
    </target>


    <!--
    ==========================================================================
    CLEANUP
    ==========================================================================
    -->
    <target name="clean" description="Delete old build, lib, dist and deployed web aritifacts">
        <delete includeemptydirs="true" failonerror="false">
            <fileset dir="${build.home}"/>
            <fileset dir="${deploy.home}"/>
            <fileset dir="${tomcat.home}/work/Catalina/localhost/${app.name}"/>
            <fileset dir="${basedir}/lib">
                <include name="*.jar"/>
            </fileset>
        </delete>
        <delete file="${dist.war}"/>
    </target>


    <!--
    ==========================================================================
    TOP-LEVEL WORKFLOWS
    ==========================================================================
    -->
    <target name="dist" depends="compile,generate-version,api_doc,compile.test" description="Create the SigmaKEE WAR and JAR.">
        <manifest file="${manifest.mf}">
            <attribute name="Built-By" value="${user.name}"/>
            <attribute name="Specification-Title" value="${product.Name}"/>
            <attribute name="Specification-Version" value="${product.version.major}.${product.version.minor}"/>
            <attribute name="Specification-Vendor" value="${spec.vendor}"/>
            <attribute name="Implementation-Title" value="${impl.title}"/>
            <attribute name="Implementation-Version" value="${product.Version} built on ${TODAY_US}"/>
            <attribute name="Implementation-Vendor" value="${nps}, ${cs.dept}"/>
            <attribute name="Implementation-URL" value="${sumo.url}"/>
            <attribute name="Implementation-Vendor-Id" value="${impl.vendor.id}"/>
            <attribute name="Main-Class" value="${main.class}"/>
        </manifest>
        <war destfile="${dist.war}" webxml="${web.dir}/web.xml" manifest="${manifest.mf}">
            <metainf file="LICENSE"/>
            <metainf file="${web.dir}/context.xml"/>
            <zipfileset dir="${dist.javadoc.dir}" prefix="javadoc"/>
            <zipfileset dir="${web.dir}/jsp"/>
            <zipfileset file="${web.dir}/simple.css"/>
            <zipfileset dir="${web.dir}/pixmaps" prefix="pixmaps"/>
            <zipfileset dir="${web.dir}/javascript" prefix="javascript"/>
            <lib dir="${basedir}/lib">
                <exclude name="junit*"/>
                <exclude name="hamcrest-core*"/>
                <exclude name="tomcat-servlet-api*"/>
            </lib>
            <classes dir="${build.classes}"/>
        </war>
        <jar destfile="${build.home}/${web.app.name}.jar"
             manifest="${manifest.mf}"
             basedir="${build.classes}">
            <metainf file="LICENSE"/>
        </jar>
    </target>    
    
    <target name="all" depends="clean,dist">
        <echo>System date/time is: ${TODAY_US}</echo>
    </target>
</project>
